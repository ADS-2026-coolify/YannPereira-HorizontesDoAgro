# Copie para .env e ajuste. No Coolify, cadastre estas mesmas chaves
# em Environment Variables, em vez de versionar o arquivo .env.

DB_NAME=sifeo_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Obrigatorio. Minimo de 32 caracteres (HS256). Troque em producao.
JWT_SECRET=sifeo_secret_key_projeto_tcc_fema_desenvolvimento_seguro_2026
JWT_EXPIRATION_MS=7200000

# Porta em que o front fica publicado no host (uso local).
WEB_PORT=8090

# Origens liberadas no CORS. Em producao, o dominio do Coolify.
CORS_ALLOWED_ORIGINS=http://localhost:8090
